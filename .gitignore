# ==============================================================================
# OBS Survey Auto-Filler - Comprehensive .gitignore
# ==============================================================================

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Chrome Extension Bundles & Private Keys (Never commit private keys!)
*.pem
*.crx
*.zip
dist/
build/

# IDEs & Code Editors
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# AI & Agentic Tool Scratches
.gemini/
scratch/
temp/
tmp/

# Logs & Runtime
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment Variables & Secrets
.env
.env.local
.env.*.local

# Python Build & Cache (for icon generation script)
__pycache__/
*.py[cod]
*$py.class
.venv/
env/
